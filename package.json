{
  "name": "patient-administration-system.github.io",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "=26"
  },
  "description": "The public website of the Patient Administration System, a prerendered SvelteKit site on GitHub Pages.",
  "license": "MIT OR Apache-2.0 OR BSD-3-Clause OR GPL-2.0-only OR GPL-3.0-only",
  "scripts": {
    "dev": "node scripts/copy-themes.mjs && vite dev",
    "build": "node scripts/derive-locales.mjs --check && node scripts/copy-themes.mjs && vite build",
    "preview": "vite preview",
    "status:sync": "node scripts/sync-status.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "locales": "node scripts/derive-locales.mjs"
  },
  "dependencies": {
    "@lilydesignsystem/svelte-headless": "0.6.1",
    "@lilydesignsystem/svelte-picker-bar": "0.5.1",
    "@lilydesignsystem/themes": "0.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.14.0",
    "marked": "^18.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
